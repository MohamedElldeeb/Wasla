# Wasla environment variables. Copy to .env.local and fill in. Never commit .env.local.
# Format: PURPOSE | WHERE USED | PHASE INTRODUCED

# --- Supabase (Phase 1) ---
# Project URL. Client + server.
NEXT_PUBLIC_SUPABASE_URL=
# Public anon key. Client + server. Safe to expose; RLS protects data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role / secret key. SERVER ONLY (Next.js server code and n8n). Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=

# --- App (Phase 2) ---
# Public base URL of the Next.js app (used for links and webhook callbacks).
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Sales WhatsApp number for plan activation, digits only e.g. 201XXXXXXXXX. OPEN: not decided yet.
WASLA_SALES_WHATSAPP=

# --- n8n (Phase 2) ---
# Base URL of the self-hosted n8n instance. Server only.
N8N_BASE_URL=
# n8n REST API key (dev tooling and server). Server only.
N8N_API_KEY=
# Shared secret / HMAC key signing webhooks between Next.js and n8n. Server + n8n.
N8N_WEBHOOK_SECRET=

# --- Apify (Phase 2) --- (used in n8n credential store; kept here for local scripts only)
APIFY_API_TOKEN=

# --- OpenRouter (Phase 2) ---
OPENROUTER_API_KEY=
# Model ID is configuration. Default is a cheap, fast model; final choice is OPEN.
OPENROUTER_MODEL=openai/gpt-4o-mini
# Model for the planner, the onboarding interview, the probe and the fit check (few, cheap calls: can be stronger than the message model).
# Round 2 decision: google/gemini-2.5-flash (best categories and signals in docs/MODEL_COMPARISON.md). Used by: the Next server (sent in webhook payloads to n8n). Phase 2. Free OpenRouter models are for development only, never the production default.
OPENROUTER_PLANNER_MODEL=google/gemini-2.5-flash
# Comma-separated fallback models used when the primary provider fails.
OPENROUTER_FALLBACK_MODELS=

# --- Email sending (Phase 3) ---
# Gmail OAuth client (Google Cloud) or SMTP creds live in the n8n credential store.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Resend (kept for later; unused until a verified domain exists, see docs/PRELAUNCH_CHECKLIST.md) ---
RESEND_API_KEY=

# --- Apollo (Phase 3) ---
# Optional platform key. Per-org keys (encrypted in Supabase Vault) override it.
APOLLO_API_KEY=

# --- Feature flags (Phase 3) ---
FF_INSTAGRAM=false
FF_FACEBOOK=false
FF_APOLLO=false
FF_LINKEDIN=false

# --- Public pilot trial accounts (landing page "try now") ---
# Set to false to disable one-click demo accounts. Remove before launch (docs/PRELAUNCH_CHECKLIST.md).
DEMO_ENABLED=true
DEMO_MAX_PER_HOUR=20

# --- Marketing screenshots (DESIGN v2 landing page) ---
# Set to 1 only on a developer machine: enables /preview, which renders real components with sample data. Never set in production.
PREVIEW_ROUTES=
